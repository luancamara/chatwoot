<p><%= t('mailers.shared.hello', name: @resource.email) %></p>

<p><%= t('mailers.auth.reset_request') %></p>

<% reset_password_params = { reset_password_token: @token } %>
<% reset_password_params[:route_url] = params[:redirect_url] if params[:redirect_url].present? %>
<% reset_password_params[:sso_account_id] = params[:sso_account_id] if params[:sso_account_id].present? %>
<p><%= link_to t('mailers.auth.change_password'), frontend_url('auth/password/edit', **reset_password_params) %></p>

<p><%= t('mailers.auth.reset_ignored') %></p>
<p><%= t('mailers.auth.reset_warning') %></p>
