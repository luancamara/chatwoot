<%
  brand_name = global_config['BRAND_NAME'] || 'Chatwoot'
  recipient_name = @resource.name.presence || @resource.email
  account_user = @resource&.account_users&.first
  inviter = account_user&.inviter
  account_name = account_user&.account&.name
  invited_user = inviter.present? && @resource.unconfirmed_email.blank?

  eyebrow = t('mailers.confirmation.welcome')
  heading = t('mailers.confirmation.heading')
  intro_text =
    t('mailers.confirmation.intro', brand_name: brand_name)
  supporting_text = t('mailers.confirmation.supporting')
  action_text = t('mailers.confirmation.confirm')
  confirmation_params = { confirmation_token: @token }
  confirmation_params[:route_url] = params[:redirect_url] if params[:redirect_url].present?
  action_url = frontend_url('auth/confirmation', **confirmation_params)
  info_title = nil
  info_text = nil
  detail_rows = []
  detail_rows << [t('mailers.confirmation.new_email'), @resource.unconfirmed_email] if @resource.unconfirmed_email.present?

  if @resource.unconfirmed_email.present?
    eyebrow = t('mailers.confirmation.email_update')
    heading = t('mailers.confirmation.confirm_new_email')
    intro_text = t('mailers.confirmation.email_update_intro', brand_name: brand_name)
    supporting_text = t('mailers.confirmation.email_update_supporting')
    action_text = t('mailers.confirmation.confirm_email')
  elsif @resource.confirmed?
    eyebrow = t('mailers.confirmation.account_ready')
    heading = t('mailers.confirmation.ready_heading')
    intro_text = t('mailers.confirmation.ready_intro', brand_name: brand_name)
    supporting_text = t('mailers.confirmation.ready_supporting')
    action_text = t('mailers.confirmation.open_account')
    action_url = frontend_url('auth/sign_in')
    detail_rows = []
  elsif invited_user
    eyebrow = t('mailers.confirmation.invitation')
    heading = account_name.present? ? t('mailers.confirmation.invited_to_account', account_name: account_name) : t('mailers.confirmation.invited_to_brand', brand_name: brand_name)
    intro_text = if account_name.present?
      t('mailers.confirmation.invitation_intro_account', inviter_name: inviter.name, account_name: account_name, brand_name: brand_name)
    else
      t('mailers.confirmation.invitation_intro_brand', inviter_name: inviter.name, brand_name: brand_name)
    end
    supporting_text = t('mailers.confirmation.invitation_supporting')
    action_text = t('mailers.confirmation.accept_invitation')
    reset_password_params = { reset_password_token: @resource.send(:set_reset_password_token) }
    reset_password_params[:route_url] = params[:redirect_url] if params[:redirect_url].present?
    reset_password_params[:sso_account_id] = params[:sso_account_id] if params[:sso_account_id].present?
    action_url = frontend_url('auth/password/edit', **reset_password_params)
    detail_rows = [[t('mailers.confirmation.invited_by'), inviter.name]]
    detail_rows << [t('mailers.confirmation.workspace'), account_name] if account_name.present?
  end
%>

<%= render partial: 'devise/mailer/confirmation_body', locals: {
  action_text: action_text,
  action_url: action_url,
  detail_rows: detail_rows,
  eyebrow: eyebrow,
  heading: heading,
  info_text: info_text,
  info_title: info_title,
  intro_text: intro_text,
  recipient_name: recipient_name,
  supporting_text: supporting_text
} %>
